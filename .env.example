# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Comma-separated fallback chain. Add a Flash-Lite backup after checking the exact ID in AI Studio.
MODEL_CHAIN=gemini-3.8-flash
ENV=development
REPORT_QUORUM=3
# Keep AUTO_APPLY=off before final submission or evaluation.
AUTO_APPLY=off
# Optional: fine-grained token with issues:write ONLY.
GITHUB_REPO=
GITHUB_TOKEN=
